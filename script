local function fireRemote(remoteName, ...)
    local remote = ReplicatedStorage:FindFirstChild(remoteName)
    if remote and remote:IsA("RemoteEvent") then
        local args = {...}
        pcall(function() remote:FireServer(table.unpack(args)) end)
        return true
    end
    return false
end

local function isBossAlive(bossModel)
    if not bossModel or not bossModel.Parent then return false end
    if bossModel.Name:match("Void") then return true end
    local hum = bossModel:FindFirstChildWhichIsA("Humanoid")
    return hum and hum.Health > 0
end

local function getVoidBoss()
    local v = Workspace:FindFirstChild("VoidOverlord")
    if v then return v end
    local bosses = Workspace:FindFirstChild("bosses")
    if bosses then
        local v2 = bosses:FindFirstChild("VoidOverlord") or bosses:FindFirstChild("Void")
        if v2 then return v2 end
    end
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj.Name:match("Void") and obj:IsA("Model") then return obj end
    end
    return nil
end

local function getBossModelByName(bossName)
    local modelName = bossName
    if bossName == "Void Overlord" then modelName = "VoidOverlord" end
    local boss = Workspace:FindFirstChild(modelName)
    if not boss then
        local bossesFolder = Workspace:FindFirstChild("bosses")
        if bossesFolder then boss = bossesFolder:FindFirstChild(modelName) end
    end
    return boss
end

