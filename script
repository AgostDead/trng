local autoTeleportAda4 = false
local teleportThread = nil
local teleportTimeLeft = 0
local adaTeleportStatus = nil

local function getAda4Part()
    local ada4 = Workspace:FindFirstChild("ada4")
    if not ada4 then return nil end
    local asc1 = ada4:FindFirstChild("asc1")
    if not asc1 then return nil end
    return asc1:FindFirstChild("asc1ic") or asc1:FindFirstChildWhichIsA("BasePart")
end

local function teleportPlayerToAda4()
    local player = Players.LocalPlayer
    if not player or not player.Character then return false end
    local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end
    local target = getAda4Part()
    if not target then return false end

    local targetPos
    if target:IsA("BasePart") then
        targetPos = target.Position
    elseif target:IsA("Model") then
        local primary = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
        if primary then targetPos = primary.Position end
    end

    if not targetPos then return false end

    myRoot.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
    return true
end

local function teleportLoop()
    while autoTeleportAda4 do
        local interval = Config.teleportInterval or 5
        teleportTimeLeft = interval
        
        while teleportTimeLeft > 0 and autoTeleportAda4 do
            task.wait(0.1)
            teleportTimeLeft = teleportTimeLeft - 0.1
            if adaTeleportStatus then
                pcall(function()
                    adaTeleportStatus:SetTitle(string.format("ТП к объекту через: %.1fс", math.max(0, teleportTimeLeft)))
                    adaTeleportStatus:SetDesc(autoTeleportAda4 and "ВКЛЮЧЕН (тебя тянет к объекту)" or "ВЫКЛЮЧЕН")
                end)
            end
        end
        
        if autoTeleportAda4 then
            teleportPlayerToAda4()
        end
    end
end

local function startAutoTeleport()
    if autoTeleportAda4 then return end
    autoTeleportAda4 = true
    Config.autoTeleportAda4 = true
    saveConfig(Config)
    teleportThread = task.spawn(teleportLoop)
end

local function stopAutoTeleport()
    autoTeleportAda4 = false
    Config.autoTeleportAda4 = false
    saveConfig(Config)
    teleportTimeLeft = 0
    if teleportThread then task.cancel(teleportThread); teleportThread = nil end
    if adaTeleportStatus then
        pcall(function()
            adaTeleportStatus:SetTitle("Телепорт к объекту выключен")
            adaTeleportStatus:SetDesc("Нажми кнопку, чтобы запустить")
        end)
    end
end

