local function smartStartDungeon(difficulty)
    local player = Players.LocalPlayer
    if not player or not player.Character then return false, "Нет персонажа" end
    local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false, "Нет HumanoidRootPart" end

    local dungeonHub = Workspace:FindFirstChild("DungeonHub")
    local liftCage = dungeonHub and dungeonHub:FindFirstChild("Hub_LiftCage")
    
    if liftCage then
        myRoot.CFrame = CFrame.new(liftCage.Position + Vector3.new(0, 5, 0))
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.2)
    end

    local remotes = ReplicatedStorage:FindFirstChild("DungeonRemotes")
    if not remotes then return false, "DungeonRemotes not found" end
    local startRun = remotes:FindFirstChild("StartRun")
    if not startRun then return false, "StartRun not found" end
    
    pcall(function() startRun:FireServer(difficulty) end)
    return true
end

local function tpToDungeonPortal()
    local player = Players.LocalPlayer
    if not player or not player.Character then return false end
    local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end

    local portal = Workspace:FindFirstChild("ada1") and Workspace.ada1:FindFirstChild("DungeonPortal")
    if not portal then return false, "DungeonPortal not found" end
    local tpPart = portal:FindFirstChild("Teleport") or portal:FindFirstChildWhichIsA("BasePart")
    if not tpPart then return false, "Teleport part not found" end

    myRoot.CFrame = CFrame.new(tpPart.Position + Vector3.new(0, 3, 0))
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
    return true
end

local function leaveDungeon()
    local remotes = ReplicatedStorage:FindFirstChild("DungeonRemotes")
    if not remotes then return end
    local leaveRun = remotes:FindFirstChild("LeaveRun")
    if leaveRun then pcall(function() leaveRun:FireServer() end) end
end

-- ============================================
--  GOD MODE (ЛЕВИТАЦИЯ ПОД ЗЕМЛЕЙ)
-- ============================================
local godModeOn = Config.godMode or false
local godModeConn = nil
local godModeDepth = Config.godModeDepth or 15

local function startGodMode()
    if godModeOn then return end
    godModeOn = true
    Config.godMode = true
    saveConfig(Config)
    
    godModeConn = RunService.Heartbeat:Connect(function()
        if not godModeOn then return end
        local player = Players.LocalPlayer
        if not player or not player.Character then return end
        local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        
        local room = getDungeonRoom()
        if room then
            local mobs = getDungeonMobs()
            if #mobs > 0 then
                local floor = room:FindFirstChild("Room_Floor") or room:FindFirstChildWhichIsA("BasePart")
                if floor then
                    local targetPos = Vector3.new(myRoot.Position.X, floor.Position.Y - godModeDepth, myRoot.Position.Z)
                    myRoot.CFrame = CFrame.new(targetPos)
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    myRoot.Anchored = true
                end
            else
                myRoot.Anchored = false
            end
        end
    end)
end

local function stopGodMode()
    if not godModeOn then return end
    godModeOn = false
    Config.godMode = false
    saveConfig(Config)
    if godModeConn then godModeConn:Disconnect(); godModeConn = nil end
    
    local player = Players.LocalPlayer
    if player and player.Character then
        local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then myRoot.Anchored = false end
    end
end

