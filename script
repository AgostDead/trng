local function bossRunLoop()
    local player = Players.LocalPlayer
    local character = player.Character
    if not character then return end
    local myRoot = character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    
    local angle = 0
    local speed = Config.bossRunSpeed or 2
    
    while bossRunOn do
        local targetBoss = currentTargetBoss
        if not targetBoss or not isBossAlive(targetBoss) then
            local voidBoss = getVoidBoss()
            if voidBoss then targetBoss = voidBoss end
            if not targetBoss then
                for _, bossName in pairs(Config.selectedBosses) do
                    if bossName ~= "Void Overlord" then
                        local boss = getBossModelByName(bossName)
                        if isBossAlive(boss) then targetBoss = boss; break end
                    end
                end
            end
        end
        
        if targetBoss then
            local bossRoot = targetBoss:FindFirstChild("HumanoidRootPart") or targetBoss:FindFirstChild("Torso") or targetBoss:FindFirstChildWhichIsA("BasePart")
            if bossRoot then
                angle = angle + (speed * 0.05)
                local radius = Config.bossRunRadius or 6
                local targetPos = bossRoot.Position + Vector3.new(
                    math.cos(angle) * radius,
                    0,
                    math.sin(angle) * radius
                )
                
                myRoot.CFrame = CFrame.new(targetPos)
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
                
                fastClickBoss(targetBoss)
            end
        end
        task.wait(Config.fAttackSpeed or 0.01)
    end
end

