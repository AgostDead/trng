local autoDungeonOn = false
local dungeonThread = nil
local DUNGEON_CHECK_DELAY = 0.5

local autoDungeonAFKOn = false
local dungeonAFKThread = nil

local function getDungeonRoom()
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj.Name:match("^DungeonRun_%d+$") then
            return obj
        end
    end
    return nil
end

local function getDungeonMobs()
    local mobs = {}
    local room = getDungeonRoom()
    if not room then return mobs end
    
    for _, mob in pairs(CollectionService:GetTagged("DungeonMob")) do
        if mob:IsDescendantOf(room) then
            table.insert(mobs, mob)
        end
    end
    return mobs
end

local function forceApplyHitboxAndFreeze()
    local mobs = getDungeonMobs()
    for _, mob in pairs(mobs) do
        local hum = mob:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            hum.PlatformStand = true
        end
        
        for _, part in pairs(mob:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function() part:SetNetworkOwner(Players.LocalPlayer) end)
                if Config.bigHitbox and part.Name == "HumanoidRootPart" then
                    local size = Config.hitboxSize or 10
                    part.Size = Vector3.new(size, size, size)
                end
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
        
        for _, d in pairs(mob:GetDescendants()) do
            if d:IsA("BodyPosition") or d:IsA("BodyGyro") 
            or d:IsA("AlignPosition") or d:IsA("AlignOrientation") then
                pcall(function() d:Destroy() end)
            end
        end
    end
end

local function dungeonFarmLoop()
    while autoDungeonOn do
        local room = getDungeonRoom()
        if not room then
            task.wait(DUNGEON_CHECK_DELAY)
            continue
        end
        
        forceApplyHitboxAndFreeze()
        
        local mobs = getDungeonMobs()
        
        if #mobs > 0 then
            local player = Players.LocalPlayer
            if player and player.Character then
                local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    local targetMob = mobs[1]
                    local mobRoot = targetMob:FindFirstChild("HumanoidRootPart") or targetMob:FindFirstChildWhichIsA("BasePart")
                    
                    if mobRoot then
                        myRoot.CFrame = CFrame.new(mobRoot.Position + Vector3.new(0, 3, 0))
                        
                        local tool = player.Character:FindFirstChildWhichIsA("Tool")
                        if tool then pcall(function() tool:Activate() end) end
                        local punchRemote = ReplicatedStorage:FindFirstChild("PunchHit")
                        if punchRemote then pcall(function() punchRemote:FireServer() end) end
                        pcall(function() VirtualUser:Button1Down(Vector2.new(0,0)); VirtualUser:Button1Up(Vector2.new(0,0)) end)
                    end
                end
            end
            task.wait(0.1)
        else
            local exitGate = room:FindFirstChild("Room_ExitGate")
            if exitGate then
                local player = Players.LocalPlayer
                if player and player.Character then
                    local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        myRoot.CFrame = CFrame.new(exitGate.Position + Vector3.new(0, 3, 0))
                        task.wait(3)
                    end
                end
            end
        end
        task.wait(0.1)
    end
end

local function dungeonAFKFarmLoop()
    while autoDungeonAFKOn do
        local room = getDungeonRoom()
        if not room then
            task.wait(DUNGEON_CHECK_DELAY)
            continue
        end
        
        local player = Players.LocalPlayer
        if not player or not player.Character then task.wait(1); continue end
        local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then task.wait(1); continue end
        
        forceApplyHitboxAndFreeze()
        
        local mobs = getDungeonMobs()
        
        if #mobs > 0 then
            for _, mob in pairs(mobs) do
                local mobRoot = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChildWhichIsA("BasePart")
                if mobRoot then
                    local offset = myRoot.Position + Vector3.new(math.random(-5,5), 0, math.random(-5,5))
                    mobRoot.CFrame = CFrame.new(offset)
                    mobRoot.AssemblyLinearVelocity = Vector3.zero
                    mobRoot.AssemblyAngularVelocity = Vector3.zero
                end
            end
            
            local tool = player.Character:FindFirstChildWhichIsA("Tool")
            if tool then pcall(function() tool:Activate() end) end
            local punchRemote = ReplicatedStorage:FindFirstChild("PunchHit")
            if punchRemote then pcall(function() punchRemote:FireServer() end) end
            pcall(function() VirtualUser:Button1Down(Vector2.new(0,0)); VirtualUser:Button1Up(Vector2.new(0,0)) end)
            
            task.wait(0.1)
        else
            local exitGate = room:FindFirstChild("Room_ExitGate")
            if exitGate then
                myRoot.CFrame = CFrame.new(exitGate.Position + Vector3.new(0, 3, 0))
            end
            task.wait(3) 
        end
        task.wait(0.1)
    end
end

