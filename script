local function teleportOrbs(folderName)
    local player = Players.LocalPlayer
    if not player or not player.Character then return 0 end
    local root = player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return 0 end
    local orbs = Workspace:FindFirstChild("Orbs")
    if not orbs then return 0 end

    local count = 0
    local pos = root.Position
    for _, ada in pairs(orbs:GetChildren()) do
        if ada:IsA("Folder") and (folderName == "All" or ada.Name == folderName) then
            for _, obj in pairs(ada:GetChildren()) do
                if shouldTeleportOrb(obj.Name) then
                    if obj:IsA("BasePart") then
                        obj.CFrame = CFrame.new(pos); obj.Anchored = true; obj.CanCollide = false
                        count = count + 1
                    elseif obj:IsA("Model") then
                        local p = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                        if p then
                            obj:PivotTo(CFrame.new(pos))
                            for _, d in pairs(obj:GetDescendants()) do if d:IsA("BasePart") then d.Anchored = true; d.CanCollide = false end end
                            count = count + 1
                        end
                    end
                end
            end
        end
    end
    return count
end

local function getMobs()
    local folder = Workspace:FindFirstChild("QuestMobs")
    if not folder then return {} end
    local list = {}
    for _, mob in pairs(folder:GetChildren()) do if mob:IsA("Model") then table.insert(list, mob) end end
    return list
end

local function getMobRoot(mob)
    if not mob or not mob.Parent then return nil end
    return mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Torso")
        or mob:FindFirstChild("UpperTorso") or mob:FindFirstChildWhichIsA("BasePart")
end

local function freezeMob(mob)
    if not mob or not mob.Parent then return end
    for _, child in pairs(mob:GetDescendants()) do
        if child:IsA("Script") or child:IsA("LocalScript") then
            child.Disabled = true
        end
    end
    for _, part in pairs(mob:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function() part:SetNetworkOwner(Players.LocalPlayer) end)
            part.CanCollide = Config.mobCollision
        end
    end
    local hum = mob:FindFirstChildWhichIsA("Humanoid")
    if hum then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.PlatformStand = true
        for _, state in pairs(Enum.HumanoidStateType:GetEnumItems()) do
            pcall(function() hum:SetStateEnabled(state, false) end)
        end
        hum:ChangeState(Enum.HumanoidStateType.Physics)
    end
end

local function prepareMob(mob)
    if not mob or not mob.Parent then return end
    freezeMob(mob)
end

local function teleportMobTo(mob, targetPos)
    if not mob or not mob.Parent then return false end
    local primary = mob.PrimaryPart or mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Torso") or mob:FindFirstChildWhichIsA("BasePart")
    if not primary then return false end
    local jitter = Vector3.new((math.random() - 0.5) * TELEPORT_JITTER, 0, (math.random() - 0.5) * TELEPORT_JITTER)
    local offset = (targetPos + jitter) - primary.Position
    for _, part in pairs(mob:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CFrame = part.CFrame + offset
            pcall(function() part.AssemblyLinearVelocity = Vector3.zero; part.AssemblyAngularVelocity = Vector3.zero end)
        end
    end
    return true
end

local function getCirclePositions(player, mobs)
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return {} end
    local positions = {}
    local total = #mobs
    if total == 0 then return positions end
    for i = 1, total do
        local angle = (i / total) * math.pi * 2
        positions[i] = myRoot.Position + Vector3.new(math.cos(angle) * CIRCLE_RADIUS, 0, math.sin(angle) * CIRCLE_RADIUS)
    end
    return positions
end

local holdingMobs = false
local heartbeatConn = nil
local lastHoldTick = 0

local function startHolding()
    if holdingMobs then return end
    holdingMobs = true
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not holdingMobs then return end
        local now = tick()
        if Config.stealthMode and (now - lastHoldTick) < HEARTBEAT_DELAY then return end
        lastHoldTick = now
        local player = Players.LocalPlayer
        if not player or not player.Character then return end
        local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        local mobs = getMobs()
        if #mobs == 0 then return end
        local positions = getCirclePositions(player, mobs)
        for i, mob in pairs(mobs) do if positions[i] then teleportMobTo(mob, positions[i]) end end
    end)
end

local function stopHolding()
    holdingMobs = false
    if heartbeatConn then heartbeatConn:Disconnect(); heartbeatConn = nil end
end

local function collectMobsOnce()
    local player = Players.LocalPlayer
    if not player or not player.Character then return 0, "Нет персонажа" end
    local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return 0, "Нет HumanoidRootPart" end
    local mobs = getMobs()
    if #mobs == 0 then return 0, "Мобы не найдены" end
    local count = 0
    local total = #mobs
    local positions = getCirclePositions(player, mobs)
    local batchSize = Config.stealthMode and MAX_MOBS_PER_BATCH or total
    for i = 1, total, batchSize do
        for j = i, math.min(i + batchSize - 1, total) do
            local mob = mobs[j]
            local targetPos = positions[j]
            if mob and targetPos then
                prepareMob(mob)
                if teleportMobTo(mob, targetPos) then count = count + 1 end
            end
        end
        if i + batchSize <= total then task.wait(BATCH_DELAY) end
    end
    return count, "OK"
end

local function attackMob(mob)
    if not mob or not mob.Parent then return false end
    local cd = mob:FindFirstChildWhichIsA("ClickDetector", true)
    if cd and fireclickdetector then pcall(function() fireclickdetector(cd) end); return true end
    return false
end

local autoAttackOn = false
local autoAttackThread = nil
local ATTACK_DELAY = 0.15

local function attackLoop()
    while autoAttackOn do
        local player = Players.LocalPlayer
        if player and player.Character then
            local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                for _, mob in pairs(getMobs()) do
                    local mr = getMobRoot(mob)
                    if mr and (mr.Position - myRoot.Position).Magnitude < 30 then
                        attackMob(mob)
                        task.wait(ATTACK_DELAY)
                    end
                end
            end
        end
        task.wait(0.1)
    end
end

