    if not leaderstats then return 0 end
    local lvl = leaderstats:FindFirstChild("Level")
    if not lvl then return 0 end
    return lvl.Value
end

local function clickMaxButtons()
    local upgradesGui = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("upgrades")
    if not upgradesGui then return end
    local frame = upgradesGui:FindFirstChild("Frame")
    if not frame then return end
    
    for _, obj in pairs(frame:GetDescendants()) do
        if obj:IsA("TextButton") and (obj.Text == "Max" or obj.Text == "MAX") and obj.Visible then
            pcall(function() obj:Activate() end)
            pcall(function() fireclickdetector(obj) end)
            pcall(function() obj.MouseButton1Click:Fire() end)
        end
    end
end

local function smartSacrificeLoop()
    local lastLevel = getLevel()
    local noGrowthTime = 0
    
    while autoSacOn do
        local currentLevel = getLevel()
        
        if currentLevel > lastLevel then
            lastLevel = currentLevel
            noGrowthTime = 0
        else
            noGrowthTime = noGrowthTime + SAC_DELAY
        end
        
        if noGrowthTime >= SMART_THRESHOLD then
            if AutoFarmToggle then
                pcall(function() AutoFarmToggle:FireServer("AutoSac", true) end)
            end
            if SacrificeEvent then
                pcall(function() SacrificeEvent:FireServer() end)
            end
            clickMaxButtons()
            noGrowthTime = 0
        end
        
        task.wait(SAC_DELAY)
    end
end

local function startAutoSac()
    if autoSacOn then return end
    autoSacOn = true
    Config.autoSacrifice = true
    saveConfig(Config)
    
    if Config.smartSacrifice then
        sacThread = task.spawn(smartSacrificeLoop)
    else
        sacThread = task.spawn(function()
            while autoSacOn do
                if AutoFarmToggle then
                    pcall(function() AutoFarmToggle:FireServer("AutoSac", true) end)
                    pcall(function() AutoFarmToggle:FireServer("AutoUpgradeSac", true) end)
                end
                clickMaxButtons()
                if SacrificeEvent then
                    pcall(function() SacrificeEvent:FireServer() end)
                end
                task.wait(SAC_DELAY)
            end
        end)
    end
end

local function stopAutoSac()
    autoSacOn = false
    Config.autoSacrifice = false
    saveConfig(Config)
    if sacThread then task.cancel(sacThread); sacThread = nil end
    if AutoFarmToggle then pcall(function() AutoFarmToggle:FireServer("AutoSac", false) end) end
end

