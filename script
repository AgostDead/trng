local function getOrbTypeFromName(orbName)
    local suffix = orbName:match("Orb_(.+)")
    return suffix or "Unknown"
end

local function shouldTeleportOrb(orbName)
    if string.sub(orbName, 1, 4) ~= "Orb_" then return false end
    return SELECTED_ORBS[getOrbTypeFromName(orbName)] == true
end

