local JumpTab = Window:Tab({ Title = "Auto Jump", Icon = "zap" })
JumpTab:Section({ Title = "Автоматический прыжок" })
local JumpStatus = JumpTab:Paragraph({ Title = "Следующий прыжок: 30с", Desc = "Auto Jump ВКЛЮЧЁН" })
local function updateAutoJump(state)
    isAutoJumpEnabled = state
    if state then
        timeLeft = jumpInterval
        task.spawn(function() task.wait(0.5); doJump() end)
        if jumpConnection then jumpConnection:Disconnect() end
        jumpConnection = RunService.Heartbeat:Connect(function(dt)
            if not isAutoJumpEnabled then return end
            timeLeft = timeLeft - dt
            if timeLeft <= 0 then doJump(); timeLeft = jumpInterval end
            pcall(function() JumpStatus:SetTitle(string.format("Следующий прыжок: %dс", math.ceil(timeLeft))); JumpStatus:SetDesc("Auto Jump ВКЛЮЧЁН") end)
        end)
    else
        if jumpConnection then jumpConnection:Disconnect(); jumpConnection = nil end
        timeLeft = jumpInterval
        pcall(function() JumpStatus:SetTitle("Следующий прыжок: " .. jumpInterval .. "с"); JumpStatus:SetDesc("Auto Jump ВЫКЛЮЧЕН") end)
    end
end
JumpTab:Toggle({ Title = "Auto Jump", Desc = "Прыгать каждые N секунд", Icon = "zap", Value = true, Callback = function(state) updateAutoJump(state) end })
