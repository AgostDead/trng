local function spawnBossLoop()
    while autoSpawnBossOn do
        local player = Players.LocalPlayer
        if player and player.Character then
            for _, bossName in pairs(Config.selectedBosses) do
                local boss = getBossModelByName(bossName)
                if not isBossAlive(boss) and bossName ~= "Void Overlord" then
                    fireRemote("BossSpawnRequest", bossName) 
                end
            end
        end
        task.wait(2)
    end
end

local function bossFarmLoop()
    while autoBossOn do
        local player = Players.LocalPlayer
        if not player or not player.Character then task.wait(1); continue end
        local myRoot = player.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then task.wait(1); continue end
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        
        if humanoid and humanoid.Health <= 0 then
            currentTargetBoss = nil
            hasTeleportedToVoid = false
            hasTeleportedToWaitZone = false
            hasTeleportedToNormalBoss = false
            task.wait(1)
            continue
        end

        local voidSelected = table.find(Config.selectedBosses, "Void Overlord")
        if voidSelected then
            local voidBoss = getVoidBoss()
            if not voidBoss then
                hasTeleportedToVoid = false
                if not hasTeleportedToWaitZone then
                    local waitZone = Workspace:FindFirstChild("VoidWaitZone")
                    if waitZone then
                        local zonePart = waitZone:FindFirstChildWhichIsA("BasePart") or waitZone
                        if zonePart and zonePart:IsA("BasePart") then
                            myRoot.CFrame = CFrame.new(zonePart.Position + Vector3.new(0, 3, 0))
                            myRoot.AssemblyLinearVelocity = Vector3.zero
                            myRoot.AssemblyAngularVelocity = Vector3.zero
                            hasTeleportedToWaitZone = true 
                        end
                    end
                end
            else
                if not hasTeleportedToVoid then
                    local voidRoot = voidBoss:FindFirstChild("HumanoidRootPart") or voidBoss:FindFirstChild("Torso") or voidBoss:FindFirstChildWhichIsA("BasePart")
                    if voidRoot then
                        myRoot.CFrame = CFrame.new(voidRoot.Position)
                        myRoot.AssemblyLinearVelocity = Vector3.zero
                        myRoot.AssemblyAngularVelocity = Vector3.zero
                        hasTeleportedToVoid = true 
                    end
                end
                currentTargetBoss = voidBoss
            end
        end

        if currentTargetBoss and not isBossAlive(currentTargetBoss) then
            currentTargetBoss = nil
            hasTeleportedToVoid = false
            hasTeleportedToWaitZone = false
            hasTeleportedToNormalBoss = false
        end

        if not currentTargetBoss or (currentTargetBoss and not currentTargetBoss.Name:match("Void")) then
            for _, bossName in pairs(Config.selectedBosses) do
                if bossName ~= "Void Overlord" then
                    local boss = getBossModelByName(bossName)
                    if isBossAlive(boss) then
                        if currentTargetBoss ~= boss then
                            currentTargetBoss = boss
                            hasTeleportedToNormalBoss = false 
                        end
                        break 
                    end
                end
            end
        end

        if currentTargetBoss and not currentTargetBoss.Name:match("Void") then
            if not hasTeleportedToNormalBoss then
                local bossRoot = currentTargetBoss:FindFirstChild("HumanoidRootPart") or currentTargetBoss:FindFirstChild("Torso") or currentTargetBoss:FindFirstChildWhichIsA("BasePart")
                if bossRoot then
                    myRoot.CFrame = CFrame.new(bossRoot.Position)
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    hasTeleportedToNormalBoss = true
                end
            end
        end
        
        if currentTargetBoss then
            if currentTargetBoss.Name:match("Void") and not hasTeleportedToVoid then
            elseif not currentTargetBoss.Name:match("Void") and not hasTeleportedToNormalBoss then
            else
                equipCombatTool()
                fastClickBoss(currentTargetBoss)
            end
        end
        task.wait(Config.fAttackSpeed or 0.01) 
    end
end

